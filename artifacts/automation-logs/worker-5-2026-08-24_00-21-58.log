$oecd = @('AUS','AUT','BEL','CAN','CHL','COL','CRI','CZE','DNK','EST','FIN','FRA','DEU','GRC','HUN','ISL','IRL','ISR','ITA','JPN','KOR','LVA','LTU','LUX','MEX','NLD','NZL','NOR','POL','PRT','SVK','SVN','ESP','SWE','CHE','TUR','GBR','USA')
function Avg($rows, $y0, $y1) {
  $s = $rows | Where-Object { [int]$_.time -ge $y0 -and [int]$_.time -le $y1 }
  if (-not $s) { return $null }
  [math]::Round((($s | Measure-Object -Property {[double]$_.obs_value} -Average).Average), 1)
}
$tot = $csv | Where-Object { $_.classif1 -eq 'ECO_SECTOR_TOTAL' -and $oecd -contains $_.ref_area }
foreach ($g in ($tot | Group-Object ref_area)) {
  $rows = $g.Group
  $a1519 = Avg $rows 2015 2019
  $a2021 = Avg $rows 2020 2021
  $a2224 = Avg $rows 2022 2024
  $latest = $rows | Sort-Object { [int]$_.time } | Select-Object -Last 1
  # skip absurd
  $lv = [double]$latest.obs_value
  if ($lv -gt 2000) { $lvNote='OUTLIER' } else { $lvNote='' }
  Write-Output ("{0}|{1}|{2}|avg1519={3}|avg2021={4}|avg2224={5}|{6}" -f $g.Name,$latest.time,[math]::Round($lv,1),$a1519,$a2021,$a2224,$lvNote)
}
