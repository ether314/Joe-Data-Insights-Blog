const contentEnd = s.lastIndexOf("`", nextPost);
const t = s.slice(contentStart, contentEnd);
console.log("words", t.trim().split(/\s+/).length);
console.log("h2", (t.match(/^## /gm) || []).length);
console.log((t.match(/^## .+/gm) || []).join("\n"));
console.log("has table", t.includes("| ---"));
console.log("len", t.length);
