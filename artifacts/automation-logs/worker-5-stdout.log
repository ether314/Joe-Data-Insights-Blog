for (const [y,v] of Object.entries(months)){
  const avg=v.reduce((a,b)=>a+b,0)/v.length/1000;
  const real=avg/(defl[y]/100);
  console.log(y+': nom='+avg.toFixed(1)+' real2019='+real.toFixed(1)+' idxNom='+(avg/(1387.8)*100).toFixed(1)+' idxReal='+(real/(1387.8)*100).toFixed(1));
}
"
