                  <XAxis type="number" tick={{ fontSize: 12 }} unit="M" />
                  <YAxis type="category" dataKey="state" width={100} tick={{ fontSize: 11 }} />
                  <Tooltip />
                  <Bar dataKey="popM" name="Limited-access pop (M)" fill={TEAL} radius={[0, 6, 6, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </div>
          </ChartCard>
          <ChartCard title="Dual twenty-year comparison" subtitle="Medill disclosed endpoints for deserts, newspaper access, density, owners">
            <div className="h-[28rem] w-full min-w-0">
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={dualCompare}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
                  <XAxis dataKey="short" tick={{ fontSize: 10 }} interval={0} />
                  <YAxis tick={{ fontSize: 12 }} />
                  <Tooltip />
                  <Legend />
                  <Bar dataKey="y2005" name="2005" fill={SLATE} radius={[4, 4, 0, 0]} />
                  <Bar dataKey="y2025" name="2025" fill={ROSE} radius={[4, 4, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </div>
          </ChartCard>
        </div>
      )}
      {view === "risk" && (
        <div className="grid gap-6 lg:grid-cols-2">
          <ChartCard title="From all counties to deserts" subtitle="Watch list: >40% modeled chance of becoming a desert within 10 years">
            <div className="h-80 w-full min-w-0">
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={funnel}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
                  <XAxis dataKey="stage" tick={{ fontSize: 10 }} interval={0} />
                  <YAxis tick={{ fontSize: 12 }} />
                  <Tooltip />
                  <Bar dataKey="counties" name="Counties" radius={[6, 6, 0, 0]}>
                    {funnel.map((_, i) => (
                      <Cell key={i} fill={[SLATE, AMBER, ROSE, NAVY][i] ?? TEAL} />
                    ))}
                  </Bar>
                </BarChart>
              </ResponsiveContainer>
            </div>
          </ChartCard>
          <ChartCard title="Public broadcast reach into thin-news counties" subtitle="Primary stations vs including repeaters (Medill signal contours)">
            <div className="h-80 w-full min-w-0">
              <ResponsiveContainer width="100%" height="100%">
                <ComposedChart data={reach}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
                  <XAxis dataKey="metric" tick={{ fontSize: 12 }} />
                  <YAxis unit="%" tick={{ fontSize: 12 }} domain={[0, 100]} />
                  <Tooltip />
                  <Legend />
                  <Bar dataKey="primary" name="Primary %" fill={INDIGO} radius={[6, 6, 0, 0]} />
                  <Line type="monotone" dataKey="repeaters" name="With repeaters %" stroke={EMERALD} strokeWidth={3} dot={{ r: 5 }} />
                </ComposedChart>
              </ResponsiveContainer>
            </div>
          </ChartCard>
        </div>
      )}
      {view === "ecosystem" && (
        <div className="grid gap-6 lg:grid-cols-2">
          <ChartCard title="Local news outlet mix (2025)" subtitle="Medill census of newspapers, digital, ethnic, and public outlets">
            <div className="h-80 w-full min-w-0">
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={outletMix} layout="vertical" margin={{ left: 16 }}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
                  <XAxis type="number" tick={{ fontSize: 12 }} />
                  <YAxis type="category" dataKey="type" width={110} tick={{ fontSize: 11 }} />
                  <Tooltip />
                  <Bar dataKey="count" name="Outlets" fill={TEAL} radius={[0, 6, 6, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </div>
          </ChartCard>
          <ChartCard title="Density vs ownership collapse" subtitle="Bubble size ??? circulation (M). X = papers/100k, Y = owners (thousands)">
            <div className="h-80 w-full min-w-0">
              <ResponsiveContainer width="100%" height="100%">
                <ScatterChart margin={{ top: 12, right: 12 }}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
                  <XAxis type="number" dataKey="papersPer100k" name="Papers/100k" tick={{ fontSize: 12 }} domain={[1, 3.5]} />
                  <YAxis type="number" dataKey="owners" name="Owners (k)" tick={{ fontSize: 12 }} unit="k" />
                  <ZAxis type="number" dataKey="circ" range={[80, 400]} />
                  <Tooltip cursor={{ strokeDasharray: "3 3" }} />
                  <Scatter name="Structure" data={structureScatter} fill={ROSE} />
                </ScatterChart>
              </ResponsiveContainer>
            </div>
          </ChartCard>
          <ChartCard title="Papers per 100k over two decades" subtitle="From 3.0 (2005) to 1.6 (2025)">
            <div className="h-64 w-full min-w-0">
              <ResponsiveContainer width="100%" height="100%">
                <LineChart data={NEWSPAPER_STRUCTURE}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
                  <XAxis dataKey="year" tick={{ fontSize: 12 }} />
                  <YAxis tick={{ fontSize: 12 }} domain={[0, 4]} />
                  <Tooltip />
                  <Line type="monotone" dataKey="papersPer100k" name="Papers / 100k" stroke={NAVY} strokeWidth={3} dot={{ r: 5, fill: AMBER }} />
                </LineChart>
              </ResponsiveContainer>
            </div>
          </ChartCard>
        </div>
      )}
      <p className="text-xs leading-relaxed text-slate-500">{SOURCE_NOTE}</p>
    </div>
  );
}
`;
