const path = 'src/components/visualizations/UsCountiesWithNoLocalNewsOutlet2026Dashboard.tsx';
const content = `"use client";
import { useMemo, useState } from "react";
import {
  Area,
  Bar,
  BarChart,
  CartesianGrid,
  Cell,
  ComposedChart,
  Legend,
  Line,
  LineChart,
  Pie,
  PieChart,
  ResponsiveContainer,
  Scatter,
  ScatterChart,
  XAxis,
  YAxis,
  ZAxis,
} from "recharts";
import { Tooltip } from "@/components/charts/SortedTooltip";
import {
  ACCESS_STACK_2025,
  DESERT_RURAL_SPLIT,
  DUAL_METRIC_COMPARE,
  HEADLINE,
  NEWSPAPER_STRUCTURE,
  OUTLET_MIX_2025,
  PUBLIC_REACH,
  RISK_FUNNEL,
  SOURCE_NOTE,
  desertSeries,
  dualMetricBars,
  fmtInt,
  fmtM,
  fmtPct,
  statesByRegion,
  type AccessMetric,
  type RegionFilter,
} from "@/data/us-counties-with-no-local-news-outlet-2026-data";
// viz-types: desert area+line, state horiz bars, risk funnel, public-reach composed, rural pie, density??owners scatter | layout: default
type ViewId = "deserts" | "states" | "risk" | "ecosystem";
const NAVY = "#0f172a";
const AMBER = "#d97706";
const TEAL = "#0f766e";
const ROSE = "#be123c";
const SLATE = "#64748b";
const INDIGO = "#4338ca";
const EMERALD = "#059669";
function ChartCard({
  title,
  subtitle,
  children,
}: {
  title: string;
  subtitle?: string;
  children: React.ReactNode;
}) {
  return (
    <div className="w-full min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <div className="border-b border-slate-100 bg-slate-50 px-5 py-4">
        <h3 className="text-lg font-bold text-slate-900">{title}</h3>
        {subtitle ? <p className="mt-1 text-sm text-slate-500">{subtitle}</p> : null}
      </div>
      <div className="p-4 sm:p-6">{children}</div>
    </div>
  );
}
function ToggleGroup<T extends string>({
  label,
  value,
  options,
  onChange,
}: {
  label: string;
  value: T;
  options: { id: T; label: string }[];
  onChange: (v: T) => void;
}) {
  return (
    <div className="flex flex-wrap items-center gap-2">
      <span className="text-xs font-semibold uppercase tracking-wide text-slate-500">{label}</span>
      <div className="inline-flex flex-wrap rounded-lg border border-slate-200 bg-white p-0.5">
        {options.map((o) => (
          <button
            key={o.id}
            type="button"
            onClick={() => onChange(o.id)}
            className={\`rounded-md px-3 py-1.5 text-sm font-medium transition-colors \${
              value === o.id ? "bg-slate-900 text-white" : "text-slate-600 hover:bg-slate-50"
            }\`}
          >
            {o.label}
          </button>
        ))}
      </div>
    </div>
  );
}
export function UsCountiesWithNoLocalNewsOutlet2026Dashboard() {
  const [view, setView] = useState<ViewId>("deserts");
  const [metric, setMetric] = useState<AccessMetric>("allOutlets");
  const [region, setRegion] = useState<RegionFilter>("all");
  const path = useMemo(() => desertSeries(), []);
  const dual = useMemo(() => dualMetricBars(metric), [metric]);
  const states = useMemo(
    () =>
      [...statesByRegion(region)]
        .map((s) => ({ state: s.state, popM: s.limitedAccessPopM }))
        .sort((a, b) => b.popM - a.popM),
    [region],
  );
  const funnel = useMemo(
    () =>
      RISK_FUNNEL.map((r) => ({
        stage: r.stage
          .replace("Watch list (>40% desert risk / 10y)", "Watch list")
          .replace("Zero outlets now", "Zero now"),
        counties: r.counties,
      })),
    [],
  );
  const reach = useMemo(
    () =>
      PUBLIC_REACH.map((p) => ({
        metric: p.metric,
        primary: p.primaryPct,
        repeaters: p.withRepeatersPct,
      })),
    [],
  );
  const ruralPie = useMemo(
    () => DESERT_RURAL_SPLIT.map((d) => ({ name: d.label, value: d.sharePct })),
    [],
  );
  const stack = useMemo(
    () => ACCESS_STACK_2025.map((a) => ({ band: a.band, counties: a.counties })),
    [],
  );
  const structureScatter = useMemo(
    () =>
      NEWSPAPER_STRUCTURE.map((n) => ({
        year: n.year,
        papersPer100k: n.papersPer100k,
        owners: n.uniqueOwners / 1000,
        circ: n.circulationM,
      })),
    [],
  );
  const outletMix = useMemo(
    () =>
      OUTLET_MIX_2025.map((o) => ({
        type: o.type.replace(" / foreign-language", ""),
        count: o.count,
      })),
    [],
  );
  const dualCompare = useMemo(
    () =>
      DUAL_METRIC_COMPARE.map((d) => ({
        short: d.metric
          .replace("Zero-outlet counties (all sources)", "Zero-outlet")
          .replace("People in 0???1 newspaper counties", "0???1 paper pop")
          .replace("Newspapers per 100k residents", "Papers/100k")
          .replace("Unique newspaper owners", "Owners"),
        y2005: d.year2005,
        y2025: d.year2025,
      })),
    [],
  );
  return (
    <div className="space-y-6" data-viz="us-counties-with-no-local-news-outlet-2026">
      <div className="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-5 py-6 text-white shadow-sm sm:px-8">
        <p className="text-xs font-semibold uppercase tracking-[0.14em] text-amber-300">
          Local information ?? Medill 2025
        </p>
        <h2 className="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
          Counties with 0???1 local news outlets
        </h2>
        <p className="mt-2 max-w-3xl text-sm text-slate-300 sm:text-base">
          Medill counts{" "}
          <span className="font-semibold text-white">{fmtInt(HEADLINE.zeroOutletCounties2025)}</span>{" "}
          U.S. counties with zero locally based news sources and{" "}
          <span className="font-semibold text-white">{fmtInt(HEADLINE.oneOutletCounties2025)}</span>{" "}
          with only one ??? about{" "}
          <span className="font-semibold text-amber-200">{fmtM(HEADLINE.limitedAccessPopM, 0)}</span>{" "}
          people with limited or no local news.
        </p>
        <div className="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <div className="rounded-lg bg-white/5 px-3 py-2">
            <p className="text-[11px] uppercase tracking-wide text-slate-400">Zero-outlet</p>
            <p className="text-xl font-bold tabular-nums">{fmtInt(HEADLINE.zeroOutletCounties2025)}</p>
          </div>
          <div className="rounded-lg bg-white/5 px-3 py-2">
            <p className="text-[11px] uppercase tracking-wide text-slate-400">One outlet</p>
