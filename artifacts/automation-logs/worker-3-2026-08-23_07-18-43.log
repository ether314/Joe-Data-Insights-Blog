                margin={{ left: 8, right: 16 }}
              >
                <CartesianGrid stroke={C.grid} strokeDasharray="3 3" />
                <XAxis type="number" tick={{ fontSize: 11 }} />
                <YAxis
                  type="category"
                  dataKey="short"
                  width={128}
                  tick={{ fontSize: 10 }}
                />
                <Tooltip />
                <Legend />
                <Bar
                  dataKey="metric"
                  name={
