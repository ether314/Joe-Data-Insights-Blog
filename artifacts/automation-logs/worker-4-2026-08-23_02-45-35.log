  .replace(/\"netCostPctAW\":/g,'netCostPctAW:')
  .replace(/\"feePctAW\":/g,'feePctAW:')
  .replace(/\"benefitPctAW\":/g,'benefitPctAW:')
  .replace(/\"taxPctAW\":/g,'taxPctAW:')
  .replace(/\"otherPctAW\":/g,'otherPctAW:')
  .replace(/\"singleNetCostPctAW\":/g,'singleNetCostPctAW:')
  .replace(/\"tfr\":/g,'tfr:')
  .replace(/\"tfrYear\":/g,'tfrYear:')
  .replace(/\"Anglosphere\"/g,'\"Anglosphere\" as RegionId')
  .replace(/\"Nordic\"/g,'\"Nordic\" as RegionId')
  .replace(/\"Continental\"/g,'\"Continental\" as RegionId')
  .replace(/\"Southern Europe\"/g,'\"Southern Europe\" as RegionId')
  .replace(/\"Central-Eastern\"/g,'\"Central-Eastern\" as RegionId')
  .replace(/\"East Asia\"/g,'\"East Asia\" as RegionId')
  .replace(/\"Other OECD\"/g,'\"Other OECD\" as RegionId')
).join(',\\n');
const maxC=rows[0];
const minT=[...rows].sort((a,b)=>a.tfr-b.tfr)[0];
const maxT=[...rows].sort((a,b)=>b.tfr-a.tfr)[0];
const file = \`/**
 * OECD net childcare costs (% of average wage) vs World Bank WDI total fertility.
 *
 * Childcare: OECD TaxBEN / Family Database NCC ??? dual-earner couple with two
 * children aged 2???3, earnings 100% + 67% of average wage, full-time centre-based
 * care, net cost as % of average wage (2022).
 * Fertility: World Bank WDI SP.DYN.TFRT.IN (2022).
 */
export const HEADLINE = {
  oecdAvgNetCostPctAW: 13,
  sampleN: \${rows.length},
  pearsonR: \${rAll},
  pearsonRExclOutliers: \${rNo},
  lowCostMeanTfr: \${mean(low,'tfr')},
  highCostMeanTfr: \${mean(high,'tfr')},
  maxNetCostPctAW: \${maxC.netCostPctAW},
  maxNetCostCountry: \"\${maxC.name}\",
  minTfr: \${minT.tfr},
  minTfrCountry: \"\${minT.name}\",
  maxTfr: \${maxT.tfr},
  maxTfrCountry: \"\${maxT.name}\",
  year: 2022,
} as const;
export const SOURCES = [
  \"OECD TaxBEN / Family Database ??? Net childcare costs (NCC), dual-earner couple 100%+67% AW, two children aged 2???3, % of average wage, 2022\",
  \"OECD PF3.4 Childcare support ??? methodology for fees, benefits, and tax interactions\",
  \"World Bank World Development Indicators ??? SP.DYN.TFRT.IN (total fertility rate), 2022\",
] as const;
export const SOURCE_NOTE =
  \"Net childcare cost is the reduction in family disposable income from purchasing full-time centre-based care for two children (ages 2 and 3), after fee rebates, childcare benefits, and tax changes. Local capital-city fee schedules are used where fees are set locally. Cross-section correlation is not causal: housing, norms, leave policy, and partnership formation also shape TFR.\";
export type RegionId =
  | \"Anglosphere\"
  | \"Nordic\"
  | \"Continental\"
  | \"Southern Europe\"
  | \"Central-Eastern\"
  | \"East Asia\"
  | \"Other OECD\";
export const REGION_META: Record<
  RegionId,
  { label: string; short: string; color: string }
> = \${JSON.stringify(REGION_META, null, 2)
  .replace(/\"Anglosphere\":/,'\"Anglosphere\":')
  .replace(/\"label\":/g,'label:')
  .replace(/\"short\":/g,'short:')
  .replace(/\"color\":/g,'color:')
  .replace(/\"Nordic\":/,'Nordic:')
  .replace(/\"Continental\":/,'Continental:')
  .replace(/\"Southern Europe\":/,'\"Southern Europe\":')
  .replace(/\"Central-Eastern\":/,'\"Central-Eastern\":')
  .replace(/\"East Asia\":/,'\"East Asia\":')
  .replace(/\"Other OECD\":/,'\"Other OECD\":')
  .replace(/\"Anglosphere\":/,'Anglosphere:')
};
export type CountryRow = {
  iso3: string;
  name: string;
  region: RegionId;
  netCostPctAW: number;
  feePctAW: number | null;
  benefitPctAW: number | null;
  taxPctAW: number | null;
  otherPctAW: number | null;
  singleNetCostPctAW: number | null;
  tfr: number;
  tfrYear: number;
};
export const COUNTRIES: CountryRow[] = [
\${countryLines}
];
export const COST_BANDS = [
  { id: \"low\" as const, label: \"Under 8% AW\", n: \${low.length}, meanNetCost: \${Math.round(mean(low,'netCostPctAW')*10)/10}, meanTfr: \${mean(low,'tfr')} },
  { id: \"mid\" as const, label: \"8???19% AW\", n: \${mid.length}, meanNetCost: \${Math.round(mean(mid,'netCostPctAW')*10)/10}, meanTfr: \${mean(mid,'tfr')} },
  { id: \"high\" as const, label: \"20%+ AW\", n: \${high.length}, meanNetCost: \${Math.round(mean(high,'netCostPctAW')*10)/10}, meanTfr: \${mean(high,'tfr')} },
];
export const REGION_AGG = \${JSON.stringify(regionAgg, null, 2)
  .replace(/\"region\": \"([^\"]+)\"/g, 'region: \"\$1\" as RegionId')
  .replace(/\"n\":/g,'n:')
  .replace(/\"meanNetCost\":/g,'meanNetCost:')
  .replace(/\"meanTfr\":/g,'meanTfr:')
};
export const DECOMPOSITION_FOCUS = [
  \"NZL\",\"USA\",\"CAN\",\"IRL\",\"GBR\",\"AUS\",\"NLD\",\"ITA\",\"KOR\",\"DEU\",
] as const;
export function costBandFor(netCostPctAW: number): \"low\" | \"mid\" | \"high\" {
  if (netCostPctAW < 8) return \"low\";
  if (netCostPctAW < 20) return \"mid\";
  return \"high\";
}
export function countriesByRegion(region: RegionId | \"All\"): CountryRow[] {
  if (region === \"All\") return COUNTRIES;
  return COUNTRIES.filter((c) => c.region === region);
}
export function decompositionRows(): {
  name: string;
  iso3: string;
  fee: number;
  benefitAbs: number;
  tax: number;
  other: number;
  net: number;
}[] {
  const set = new Set<string>(DECOMPOSITION_FOCUS);
  return COUNTRIES.filter((c) => set.has(c.iso3)).map((c) => ({
    name: c.name,
    iso3: c.iso3,
    fee: c.feePctAW ?? 0,
    benefitAbs: Math.abs(c.benefitPctAW ?? 0),
    tax: c.taxPctAW ?? 0,
    other: c.otherPctAW ?? 0,
    net: c.netCostPctAW,
  }));
}
\`;
fs.writeFileSync('src/data/oecd-childcare-costs-versus-total-fertility-2026-data.ts', file);
