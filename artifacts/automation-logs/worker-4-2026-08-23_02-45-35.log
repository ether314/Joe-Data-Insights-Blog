const rows=JSON.parse(fs.readFileSync('artifacts/countries-verified.json','utf8'));
// map East Asia region id
const REGION_META = {
  Anglosphere: { label: 'Anglosphere', short: 'ANG', color: '#38bdf8' },
  Nordic: { label: 'Nordic', short: 'NOR', color: '#34d399' },
  Continental: { label: 'Continental Europe', short: 'CON', color: '#a78bfa' },
  'Southern Europe': { label: 'Southern Europe', short: 'SOU', color: '#fbbf24' },
  'Central-Eastern': { label: 'Central & Eastern Europe', short: 'CEE', color: '#fb7185' },
  'East Asia': { label: 'East Asia', short: 'EAS', color: '#f97316' },
  'Other OECD': { label: 'Other OECD', short: 'OTH', color: '#94a3b8' },
};
function pearson(pts){
  const xs=pts.map(p=>p.netCostPctAW), ys=pts.map(p=>p.tfr);
  const n=xs.length; const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
  let num=0,dx=0,dy=0; for(let i=0;i<n;i++){num+=(xs[i]-mx)*(ys[i]-my);dx+=(xs[i]-mx)**2;dy+=(ys[i]-my)**2;}
  return Math.round((num/Math.sqrt(dx*dy))*1000)/1000;
}
const rAll=pearson(rows);
const rNo=pearson(rows.filter(r=>r.iso3!=='ISR'&&r.iso3!=='KOR'));
const low=rows.filter(r=>r.netCostPctAW<8);
const mid=rows.filter(r=>r.netCostPctAW>=8&&r.netCostPctAW<20);
const high=rows.filter(r=>r.netCostPctAW>=20);
const mean=(a,k)=>Math.round(a.reduce((s,x)=>s+x[k],0)/a.length*1000)/1000;
const byR={}; for(const r of rows)(byR[r.region]||=[]).push(r);
const regionAgg=Object.entries(byR).map(([region,list])=>({
  region, n:list.length,
  meanNetCost: Math.round(mean(list,'netCostPctAW')*10)/10,
  meanTfr: mean(list,'tfr'),
})).sort((a,b)=>a.meanNetCost-b.meanNetCost);
const countryLines = rows.map(r => '  ' + JSON.stringify(r)
