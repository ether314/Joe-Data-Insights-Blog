const fs=require('fs');
const j=JSON.parse(fs.readFileSync('artifacts/oecd-ncc-2022.json','utf8'));
const dims=j.data.structures[0].dimensions.series;
const idx = Object.fromEntries(dims.map((d,i)=>[d.id,i]));
function find(dimId, code){ return dims[idx[dimId]].values.findIndex(v=>v.id===code); }
const series=j.data.dataSets[0].series;
const areas=dims[idx.REF_AREA].values;
function extract(unit, hh, curr, part, cost='_T'){
  const want={MEASURE:0, UNIT:find('UNIT_MEASURE',unit), CURR:find('INCOME_CURR',curr), HH:find('HOUSEHOLD_TYPE',hh), AGE:0, PART:find('INCOME_PART',part), USE:0, SOC:0, HOUSE:0, COST:find('CHILDCARE_COST',cost), FREQ:0};
  const out=[];
  for(let ai=0;ai<areas.length;ai++){
    const key=[ai,want.MEASURE,want.UNIT,want.CURR,want.HH,want.AGE,want.PART,want.USE,want.SOC,want.HOUSE,want.COST,want.FREQ].join(':');
    const s=series[key]; if(!s) continue; const v=s.observations['0']?.[0]; if(v==null) continue;
    out.push({iso3:areas[ai].id, v:Math.round(v*10)/10});
  }
  return out;
}
const aw=extract('PT_WG_A_SAL','C_C2','AW100','AW67');
const inc=extract('PT_INC_DISP_HH','C_C2','AW100','AW67');
const canAw=aw.find(d=>d.iso3==='CAN');
const canInc=inc.find(d=>d.iso3==='CAN');
const oecdAw=aw.find(d=>d.iso3==='OECD');
const oecdInc=inc.find(d=>d.iso3==='OECD');
console.log({canAw,canInc,oecdAw,oecdInc});
// also fee/benefit for a few
