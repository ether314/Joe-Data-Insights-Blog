const fs=require('fs');
const {oecdAvg, rows}=JSON.parse(fs.readFileSync('artifacts/ncc-tfr-full.json','utf8'));
const singles=JSON.parse(fs.readFileSync('artifacts/oecd-ncc-single-aw67-2022.json','utf8'));
// pearson helpers
function pearson(pts, xk, yk){
  const xs=pts.map(p=>p[xk]), ys=pts.map(p=>p[yk]);
  const n=xs.length; const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
  let num=0,dx=0,dy=0; for(let i=0;i<n;i++){num+=(xs[i]-mx)*(ys[i]-my);dx+=(xs[i]-mx)**2;dy+=(ys[i]-my)**2;}
  return Math.round((num/Math.sqrt(dx*dy))*1000)/1000;
}
const rAll=pearson(rows,'netCostPctAW','tfr');
const noOut=rows.filter(r=>r.iso3!=='ISR'&&r.iso3!=='KOR');
const rNo=pearson(noOut,'netCostPctAW','tfr');
const low=rows.filter(r=>r.netCostPctAW<8);
const mid=rows.filter(r=>r.netCostPctAW>=8&&r.netCostPctAW<20);
const high=rows.filter(r=>r.netCostPctAW>=20);
function mean(arr,k){return Math.round(arr.reduce((a,b)=>a+b[k],0)/arr.length*1000)/1000;}
const byRegion={};
for (const r of rows){ (byRegion[r.region]||(byRegion[r.region]=[])).push(r); }
const regionAgg=Object.entries(byRegion).map(([region,list])=>({
  region, n:list.length,
  meanNetCost: Math.round(mean(list,'netCostPctAW')*10)/10,
  meanTfr: mean(list,'tfr'),
  minTfr: Math.min(...list.map(d=>d.tfr)),
  maxTfr: Math.max(...list.map(d=>d.tfr)),
})).sort((a,b)=>a.meanNetCost-b.meanNetCost);
const costBands=[
  {id:'low', label:'Under 8% AW', min:0, max:8, n:low.length, meanTfr:mean(low,'tfr'), meanCost:Math.round(mean(low,'netCostPctAW')*10)/10},
  {id:'mid', label:'8???19% AW', min:8, max:20, n:mid.length, meanTfr:mean(mid,'tfr'), meanCost:Math.round(mean(mid,'netCostPctAW')*10)/10},
  {id:'high', label:'20%+ AW', min:20, max:100, n:high.length, meanTfr:mean(high,'tfr'), meanCost:Math.round(mean(high,'netCostPctAW')*10)/10},
];
console.log({rAll,rNo,oecdAvg,costBands,regionAgg});
fs.writeFileSync('artifacts/ncc-stats.json', JSON.stringify({rAll,rNo,oecdAvg,costBands,regionAgg,n:rows.length},null,2));
