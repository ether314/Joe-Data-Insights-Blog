const fs=require('fs');
const ncc=JSON.parse(fs.readFileSync('artifacts/oecd-ncc-dual-earner-2022.json','utf8'));
const tfr=JSON.parse(fs.readFileSync('artifacts/wdi-tfr-oecd.json','utf8'));
const tfrMap=Object.fromEntries(tfr.map(r=>[r.iso3,r]));
const joined=ncc.filter(r=>tfrMap[r.iso3] && r.iso3!=='OECD').map(r=>({
  iso3:r.iso3, name:r.name==='Korea'?'Korea':r.name,
  netCostPctAW:r.netCostPctAW, tfr:tfrMap[r.iso3].tfr, tfrYear:tfrMap[r.iso3].year
}));
// pearson
const xs=joined.map(d=>d.netCostPctAW), ys=joined.map(d=>d.tfr);
const n=xs.length;
const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
let num=0,dx=0,dy=0;
for(let i=0;i<n;i++){num+=(xs[i]-mx)*(ys[i]-my);dx+=(xs[i]-mx)**2;dy+=(ys[i]-my)**2;}
const r=num/Math.sqrt(dx*dy);
console.log('n',n,'r',Math.round(r*1000)/1000,'meanCost',Math.round(mx*10)/10,'meanTfr',Math.round(my*1000)/1000);
console.log('low cost (<8) mean TFR', (()=>{const s=joined.filter(d=>d.netCostPctAW<8); return [s.length, (s.reduce((a,b)=>a+b.tfr,0)/s.length).toFixed(3)];})());
console.log('high cost (>=20) mean TFR', (()=>{const s=joined.filter(d=>d.netCostPctAW>=20); return [s.length, (s.reduce((a,b)=>a+b.tfr,0)/s.length).toFixed(3)];})());
console.log(JSON.stringify(joined.sort((a,b)=>a.netCostPctAW-b.netCostPctAW),null,2));
fs.writeFileSync('artifacts/ncc-tfr-joined.json', JSON.stringify(joined,null,2));
