const fs=require('fs');
const j=JSON.parse(fs.readFileSync('artifacts/oecd-ncc-2022.json','utf8'));
const dims=j.data.structures[0].dimensions.series;
const idx = Object.fromEntries(dims.map((d,i)=>[d.id,i]));
function find(dimId, code){ return dims[idx[dimId]].values.findIndex(v=>v.id===code); }
const want = {
  MEASURE: find('MEASURE','NCF'),
  UNIT_MEASURE: find('UNIT_MEASURE','PT_WG_A_SAL'),
  INCOME_CURR: find('INCOME_CURR','AW100'),
  HOUSEHOLD_TYPE: find('HOUSEHOLD_TYPE','C_C2'),
  AGE_CHILDREN: find('AGE_CHILDREN','Y2_3'),
  INCOME_PART: find('INCOME_PART','AW67'),
  CHILDCARE_USE: find('CHILDCARE_USE','YES'),
  SOC_ASS_BENEFIT: find('SOC_ASS_BENEFIT','YES'),
  HOUSE_BENEFIT: find('HOUSE_BENEFIT','YES'),
  CHILDCARE_COST: find('CHILDCARE_COST','_T'),
  FREQ: find('FREQ','A'),
};
console.log('want', want);
const series=j.data.dataSets[0].series;
const areas=dims[idx.REF_AREA].values;
const rows=[];
for (let ai=0; ai<areas.length; ai++) {
  const key=[ai, want.MEASURE, want.UNIT_MEASURE, want.INCOME_CURR, want.HOUSEHOLD_TYPE, want.AGE_CHILDREN, want.INCOME_PART, want.CHILDCARE_USE, want.SOC_ASS_BENEFIT, want.HOUSE_BENEFIT, want.CHILDCARE_COST, want.FREQ].join(':');
  const s=series[key];
  if (!s) continue;
  const val=s.observations['0']?.[0];
  if (val==null) continue;
  rows.push({iso3:areas[ai].id, name:areas[ai].name, netCostPctAW: Math.round(val*10)/10});
}
rows.sort((a,b)=>b.netCostPctAW-a.netCostPctAW);
console.log(JSON.stringify(rows,null,2));
fs.writeFileSync('artifacts/oecd-ncc-dual-earner-2022.json', JSON.stringify(rows,null,2));
console.log('n', rows.length);
// also get single parent AW67 for comparison
const want2={...want, HOUSEHOLD_TYPE: find('HOUSEHOLD_TYPE','S_C2'), INCOME_CURR: find('INCOME_CURR','AW67'), INCOME_PART: find('INCOME_PART','_Z')};
const singles=[];
for (let ai=0; ai<areas.length; ai++) {
  const key=[ai, want2.MEASURE, want2.UNIT_MEASURE, want2.INCOME_CURR, want2.HOUSEHOLD_TYPE, want2.AGE_CHILDREN, want2.INCOME_PART, want2.CHILDCARE_USE, want2.SOC_ASS_BENEFIT, want2.HOUSE_BENEFIT, want2.CHILDCARE_COST, want2.FREQ].join(':');
  const s=series[key];
  if (!s) continue;
  const val=s.observations['0']?.[0];
  if (val==null) continue;
  singles.push({iso3:areas[ai].id, name:areas[ai].name, netCostPctAW: Math.round(val*10)/10});
}
singles.sort((a,b)=>b.netCostPctAW-a.netCostPctAW);
fs.writeFileSync('artifacts/oecd-ncc-single-aw67-2022.json', JSON.stringify(singles,null,2));
console.log('singles', singles.length, 'top', singles.slice(0,5));
"
