const fs = require('fs');
const path = 'src/data/posts.ts';
const frag = fs.readFileSync('src/data/_construction-sand-post-fragment.ts','utf8');
const m = frag.match(/export const constructionSandExtractionAndTrade2026Post: Post = (\{[\s\S]*\});\s*$/);
if (!m) { console.error('no post object'); process.exit(1); }
const obj = m[1];
let posts = fs.readFileSync(path,'utf8');
const needle = 'export const samplePosts: Post[] = [';
const i = posts.indexOf(needle);
if (i < 0) { console.error('no samplePosts'); process.exit(1); }
const insertAt = i + needle.length;
posts = posts.slice(0, insertAt) + '\n  ' + obj + ',\n' + posts.slice(insertAt);
fs.writeFileSync(path, posts);
fs.unlinkSync('src/data/_construction-sand-post-fragment.ts');
