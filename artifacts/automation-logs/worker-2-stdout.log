  slug: 'women-and-men-in-apprentice-trades-2026',
  title: 'Charted: Women Are 14.8% of Apprentices Overall ??? But Only 4.5% in Construction Trades',
  excerpt: 'IWPR analysis of DOL RAPIDS puts women at 14.8% of apprentices with sex reported in FY 2023, up from 9.2% in 2014. Construction remains at 4.5% women while health and social assistance sits at 84.7%. The fastest shift is inside women???s own pipeline: health???s share of women apprentices rose from 5.6% to 16.0% (2016???2023) as construction???s slice fell.',
  category: 'Labor & Skills',
  themeId: 'apprenticeship-pipelines',
  imageUrl: '/images/labor-skills-women-and-men-in-apprentice-trades-2026-hero.png',
  imageAlt: 'Dark navy cinematic data-viz hero with amber construction trade bars beside magenta health-apprenticeship bars and geometric hard-hat and wrench motifs',
  publishedAt: '2026-08-23T20:00:00Z',
  featured: true,
  visualization: 'women-and-men-in-apprentice-trades-2026',
  layout: 'default',
  content: body,
};
function serialize(obj){
  const lines=[];
  lines.push('  {');
  for (const [k,v] of Object.entries(obj)){
    if (k==='content'){
      lines.push('    content: \`'+v.replace(/\\\\/g,'\\\\\\\\').replace(/\`/g,'\\\\\`').replace(/\$\{/g,'\\\\\${')+'\`,');
    } else if (typeof v==='string'){
      lines.push('    '+k+': '+JSON.stringify(v)+',');
    } else if (typeof v==='boolean'){
      lines.push('    '+k+': '+v+',');
    } else {
      lines.push('    '+k+': '+JSON.stringify(v)+',');
    }
  }
  lines.push('  },');
  return lines.join('\n');
}
const path='src/data/posts.ts';
let s=fs.readFileSync(path,'utf8');
const marker='export const samplePosts: Post[] = [';
const idx=s.indexOf(marker);
if(idx<0) throw new Error('marker missing');
const insertAt=idx+marker.length;
const block='\n'+serialize(entry);
s=s.slice(0,insertAt)+block+s.slice(insertAt);
fs.writeFileSync(path,s);
console.log('inserted ok');
