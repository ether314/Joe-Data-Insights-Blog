import { chromium } from 'playwright';
import { startStaticServer, stopStaticServer } from './scripts/lib/static-server.mjs';
import path from 'node:path';
const outDir = path.join(process.cwd(), 'out');
const port = 4186;
const server = await startStaticServer(outDir, port);
const browser = await chromium.launch({ headless: true });
const page = await browser.newPage();
for (const { slug, marker } of [
  { slug: 'hospital-system-clout-vs-commercial-prices-2026', marker: 'Hospital clout' },
  { slug: 'irena-renewable-capacity-record-2024', marker: 'Renewable' },
]) {
  const url = 'http://127.0.0.1:' + port + '/blog/' + slug + '.html';
  await page.goto(url, { waitUntil: 'networkidle', timeout: 45000 });
  const stuck = await page.getByText('Loading interactive charts', { exact: false }).isVisible().catch(() => false);
  const found = await page.getByText(marker, { exact: false }).first().isVisible().catch(() => false);
  console.log(slug, { stuck, found });
}
await browser.close();
await stopStaticServer(server);
"
