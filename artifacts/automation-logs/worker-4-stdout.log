  'https://sdmx.oecd.org/public/rest/data/OECD.ELS.JAI,DSD_TAXBEN_NCC@DF_NCC/.NCF.PT_AW.AW100.C_C2..AW67..YES.YES._T.A?startPeriod=2022&endPeriod=2022&dimensionAtObservation=AllDimensions&format=csvfilewithlabels'
)
foreach ($u in $urls) {
  try {
    Write-Host "TRY $u"
    $r = Invoke-WebRequest -Uri $u -UseBasicParsing -TimeoutSec 60
    Write-Host "STATUS $($r.StatusCode) LEN $($r.Content.Length)"
    $r.Content.Substring(0, [Math]::Min(2000, $r.Content.Length)) | Out-File 'artifacts/oecd-ncc-sample.txt'
    $r.Content | Out-File 'artifacts/oecd-ncc-2022.csv' -Encoding utf8
    break
  } catch {
    Write-Host "FAIL $($_.Exception.Message)"
  }
}
