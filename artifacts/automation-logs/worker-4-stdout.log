[cot:tool] start shell $urls = @(
{
  "ok": true,
  "updatedAt": "2026-08-25T14:50:57.425Z"
}
  'https://www.census.gov/econ/bfs/csv/bfs_month.csv',
  'https://www.census.gov/econ/bfs/csv/BFS_Month.csv',
  'https://www.census.gov/econ/bfs/csv/bf_month.csv',
  'https://www2.census.gov/programs-surveys/bfs/tables/time-series/bfs/bfs_month.csv',
  'https://www.census.gov/econ/currentdata/datasets/BFS-Datasets.zip',
  'https://www.census.gov/econ/bfs/historical.html',
  'https://www.atlantafed.org/-/media/documents/datafiles/research/business-formation/bfs-state.xlsx',
  'https://www.atlantafed.org/research/data-and-tools/business-formation-statistics'
)
foreach ($u in $urls) {
  try {
    $r = Invoke-WebRequest -Uri $u -UseBasicParsing -TimeoutSec 35 -MaximumRedirection 5
    $ct = $r.Headers['Content-Type']
    Write-Output "OK $($r.StatusCode) ct=$ct len=$($r.RawContentLength) $u"
    if ($ct -match 'html|text') {
      $links = [regex]::Matches($r.Content, 'href="([^"]+\.(?:csv|xlsx|zip|xls))"') | ForEach-Object { $_.Groups[1].Value } | Select-Object -First 25
      $links | ForEach-Object { Write-Output "  LINK $_" }
    }
  } catch {
    Write-Output "FAIL $u :: $($_.Exception.Message)"
  }
}
