[cot:tool] start shell # Try Census currentdata + historical pages; also FRED CSV with longer timeout
{
  "ok": true,
  "updatedAt": "2026-08-25T14:50:58.035Z"
}
$urls = @(
  'https://www.census.gov/econ/bfs/pdf/bfs_current.pdf',
  'https://www.census.gov/econ/currentdata/',
  'https://fred.stlouisfed.org/graph/fredgraph.csv?id=BABATOTALSAUS',
  'https://fred.stlouisfed.org/graph/fredgraph.csv?id=BAHBATOTALSAUS',
  'https://fred.stlouisfed.org/graph/fredgraph.csv?id=BFBF8QTOTALNSAUS'
)
foreach ($u in $urls) {
  try {
    $out = if ($u -match 'fredgraph') { "tmp\bfs\$(($u -split 'id=')[1]).csv" } else { $null }
    if ($out) {
      Invoke-WebRequest -Uri $u -OutFile $out -UseBasicParsing -TimeoutSec 90
      Write-Output "OK FRED $out $((Get-Item $out).Length)"
      Get-Content $out -TotalCount 3
    } else {
      $r = Invoke-WebRequest -Uri $u -UseBasicParsing -TimeoutSec 40
      Write-Output "OK $($r.StatusCode) len=$($r.RawContentLength) $u"
      if ($r.Content -match 'csv|xlsx|download') {
        [regex]::Matches($r.Content, 'href="([^"]*(?:csv|xlsx|zip|xls)[^"]*)"') | ForEach-Object { $_.Groups[1].Value } | Select-Object -First 20 | ForEach-Object { Write-Output "  $_" }
      }
    }
  } catch { Write-Output "FAIL $u :: $($_.Exception.Message)" }
}
[cot:tool] done webFetch
