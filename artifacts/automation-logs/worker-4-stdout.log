const fs=require('fs');
const j=JSON.parse(fs.readFileSync('artifacts/oecd-ncc-2022.json','utf8'));
const dims=j.data.structures[0].dimensions.series;
const idx = Object.fromEntries(dims.map((d,i)=>[d.id,i]));
function find(dimId, code){ return dims[idx[dimId]].values.findIndex(v=>v.id===code); }
const series=j.data.dataSets[0].series;
const areas=dims[idx.REF_AREA].values;
function extract(hh, curr, part, cost){
  const want={MEASURE:0, UNIT:0, CURR:find('INCOME_CURR',curr), HH:find('HOUSEHOLD_TYPE',hh), AGE:0, PART:find('INCOME_PART',part), USE:0, SOC:0, HOUSE:0, COST:find('CHILDCARE_COST',cost), FREQ:0};
  const out={};
  for(let ai=0;ai<areas.length;ai++){
    const key=[ai,want.MEASURE,want.UNIT,want.CURR,want.HH,want.AGE,want.PART,want.USE,want.SOC,want.HOUSE,want.COST,want.FREQ].join(':');
    const s=series[key]; if(!s) continue; const v=s.observations['0']?.[0]; if(v==null) continue;
    out[areas[ai].id]=Math.round(v*10)/10;
  }
  return out;
}
const dualNet=extract('C_C2','AW100','AW67','_T');
const dualFee=extract('C_C2','AW100','AW67','CF');
const dualBen=extract('C_C2','AW100','AW67','CB');
const dualTax=extract('C_C2','AW100','AW67','TAX');
const dualOth=extract('C_C2','AW100','AW67','_O');
const singleNet=extract('S_C2','AW67','_Z','_T');
const tfr=Object.fromEntries(JSON.parse(fs.readFileSync('artifacts/wdi-tfr-oecd.json','utf8')).map(r=>[r.iso3,r]));
const region={
  AUS:'Anglosphere',CAN:'Anglosphere',IRL:'Anglosphere',NZL:'Anglosphere',GBR:'Anglosphere',USA:'Anglosphere',
  DNK:'Nordic',FIN:'Nordic',ISL:'Nordic',NOR:'Nordic',SWE:'Nordic',
  AUT:'Continental',BEL:'Continental',CHE:'Continental',DEU:'Continental',FRA:'Continental',LUX:'Continental',NLD:'Continental',
  ESP:'Southern Europe',GRC:'Southern Europe',ITA:'Southern Europe',PRT:'Southern Europe',
  CZE:'Central-Eastern',EST:'Central-Eastern',HUN:'Central-Eastern',LTU:'Central-Eastern',LVA:'Central-Eastern',POL:'Central-Eastern',SVK:'Central-Eastern',SVN:'Central-Eastern',
  JPN:'East Asia',KOR:'East Asia',ISR:'Other OECD'
};
const names={AUS:'Australia',AUT:'Austria',BEL:'Belgium',CAN:'Canada',CHE:'Switzerland',CZE:'Czechia',DEU:'Germany',DNK:'Denmark',ESP:'Spain',EST:'Estonia',FIN:'Finland',FRA:'France',GBR:'United Kingdom',GRC:'Greece',HUN:'Hungary',IRL:'Ireland',ISL:'Iceland',ISR:'Israel',ITA:'Italy',JPN:'Japan',KOR:'Korea',LTU:'Lithuania',LUX:'Luxembourg',LVA:'Latvia',NLD:'Netherlands',NOR:'Norway',NZL:'New Zealand',POL:'Poland',PRT:'Portugal',SVK:'Slovak Republic',SVN:'Slovenia',SWE:'Sweden',USA:'United States'};
const rows=[];
for (const iso of Object.keys(names)) {
  if (dualNet[iso]==null || !tfr[iso]) continue;
  rows.push({
    iso3:iso, name:names[iso], region:region[iso],
    netCostPctAW: dualNet[iso],
    feePctAW: dualFee[iso]??null,
    benefitPctAW: dualBen[iso]??null,
    taxPctAW: dualTax[iso]??null,
    otherPctAW: dualOth[iso]??null,
    singleNetCostPctAW: singleNet[iso]??null,
    tfr: tfr[iso].tfr,
    tfrYear: tfr[iso].year,
  });
}
rows.sort((a,b)=>b.netCostPctAW-a.netCostPctAW);
fs.writeFileSync('artifacts/ncc-tfr-full.json', JSON.stringify({oecdAvg:dualNet.OECD, rows},null,2));
console.log('rows', rows.length, 'oecd', dualNet.OECD);
"
