import fs from 'fs';
import path from 'path';
const dir='tmp/bfs/states';
const names={AL:'Alabama',AK:'Alaska',AZ:'Arizona',AR:'Arkansas',CA:'California',CO:'Colorado',CT:'Connecticut',DE:'Delaware',DC:'District of Columbia',FL:'Florida',GA:'Georgia',HI:'Hawaii',ID:'Idaho',IL:'Illinois',IN:'Indiana',IA:'Iowa',KS:'Kansas',KY:'Kentucky',LA:'Louisiana',ME:'Maine',MD:'Maryland',MA:'Massachusetts',MI:'Michigan',MN:'Minnesota',MS:'Mississippi',MO:'Missouri',MT:'Montana',NE:'Nebraska',NV:'Nevada',NH:'New Hampshire',NJ:'New Jersey',NM:'New Mexico',NY:'New York',NC:'North Carolina',ND:'North Dakota',OH:'Ohio',OK:'Oklahoma',OR:'Oregon',PA:'Pennsylvania',RI:'Rhode Island',SC:'South Carolina',SD:'South Dakota',TN:'Tennessee',TX:'Texas',UT:'Utah',VT:'Vermont',VA:'Virginia',WA:'Washington',WV:'West Virginia',WI:'Wisconsin',WY:'Wyoming'};
const regions={AL:'South',AK:'West',AZ:'West',AR:'South',CA:'West',CO:'West',CT:'Northeast',DE:'South',DC:'South',FL:'South',GA:'South',HI:'West',ID:'West',IL:'Midwest',IN:'Midwest',IA:'Midwest',KS:'Midwest',KY:'South',LA:'South',ME:'Northeast',MD:'South',MA:'Northeast',MI:'Midwest',MN:'Midwest',MS:'South',MO:'Midwest',MT:'West',NE:'Midwest',NV:'West',NH:'Northeast',NJ:'Northeast',NM:'West',NY:'Northeast',NC:'South',ND:'Midwest',OH:'Midwest',OK:'South',OR:'West',PA:'Northeast',RI:'Northeast',SC:'South',SD:'Midwest',TN:'South',TX:'South',UT:'West',VT:'Northeast',VA:'South',WA:'West',WV:'South',WI:'Midwest',WY:'West'};
function readCsv(f){const lines=fs.readFileSync(f,'utf8').trim().split(/\r?\n/).slice(1); const m=new Map(); for(const line of lines){const [d,v]=line.split(','); if(!d||v===undefined||v==='') continue; m.set(d.slice(0,7), Number(v));} return m;}
function sumRange(map, start, end){ // YYYY-MM inclusive
  let s=0, n=0; for(const [ym,v] of map){ if(ym>=start && ym<=end && Number.isFinite(v)){ s+=v; n++; } } return {s, n}; }
const cohortStart='2020-01', cohortEnd='2022-12'; // apps with ~3y+ window by mid-2026; BF8Q fully observed for these
const recentStart='2023-01', recentEnd='2023-12'; // partial/projected BF8Q vintage
const pathNatH='tmp/bfs/BAHBATOTALSAUS.csv';
const pathNatB='tmp/bfs/BFSBF8QTOTALNSAUS.csv';
const pathNatBA='tmp/bfs/BABATOTALSAUS.csv';
const natH=readCsv(pathNatH), natB=readCsv(pathNatB), natBA=readCsv(pathNatBA);
const natCohort={hba:sumRange(natH,cohortStart,cohortEnd), bf:sumRange(natB,cohortStart,cohortEnd), ba:sumRange(natBA,cohortStart,cohortEnd)};
const states=[];
for(const st of Object.keys(names)){
  const h=readCsv(path.join(dir,\`\${st}_hba.csv\`));
  const b=readCsv(path.join(dir,\`\${st}_bf8q.csv\`));
  const cH=sumRange(h,cohortStart,cohortEnd);
  const cB=sumRange(b,cohortStart,cohortEnd);
  const rH=sumRange(h,recentStart,recentEnd);
  const rB=sumRange(b,recentStart,recentEnd);
  // monthly national path for 2020-2025 annual
  if(cH.s<=0 || cB.s<=0) { console.error('bad',st,cH,cB); continue; }
  const appsPerEmp = cH.s / cB.s;
  const convPct = 100 * cB.s / cH.s;
  states.push({
    code:st, name:names[st], region:regions[st],
    hba2020_22: Math.round(cH.s),
    bf8q2020_22: Math.round(cB.s),
    appsPerEmployer: +appsPerEmp.toFixed(2),
    conversionPct: +convPct.toFixed(1),
    hba2023: Math.round(rH.s),
    bf8q2023: Math.round(rB.s),
    appsPerEmployer2023: +(rH.s/rB.s).toFixed(2),
    conversionPct2023: +(100*rB.s/rH.s).toFixed(1),
  });
}
states.sort((a,b)=>b.appsPerEmployer-a.appsPerEmployer);
// annual national series 2017-2025
const annual=[];
for(let y=2017;y<=2025;y++){
  const a=sumRange(natH,\`\${y}-01\`,\`\${y}-12\`);
  const b=sumRange(natB,\`\${y}-01\`,\`\${y}-12\`);
  const ba=sumRange(natBA,\`\${y}-01\`,\`\${y}-12\`);
  annual.push({year:y, hba:Math.round(a.s), bf8q:Math.round(b.s), ba:Math.round(ba.s), appsPerEmployer:+(a.s/b.s).toFixed(2), conversionPct:+(100*b.s/a.s).toFixed(1), hbaSharePct:+(100*a.s/ba.s).toFixed(1)});
}
// monthly national from 2019
const monthly=[];
for(const [ym,h] of [...natH.entries()].sort()){
  if(ym<'2019-01' || ym>'2026-07') continue;
  const b=natB.get(ym); const ba=natBA.get(ym);
  if(!b||!ba) continue;
  monthly.push({ym, hba:Math.round(h), bf8q:Math.round(b), ba:Math.round(ba), appsPerEmployer:+(h/b).toFixed(2)});
}
const usApps = natCohort.hba.s/natCohort.bf.s;
const usConv = 100*natCohort.bf.s/natCohort.hba.s;
const ranked=[...states].sort((a,b)=>a.appsPerEmployer-b.appsPerEmployer);
const headline={
  usAppsPerEmployer:+usApps.toFixed(2),
  usConversionPct:+usConv.toFixed(1),
  cohortLabel:'2020???2022 application months',
  windowNote:'BF8Q = formations within 8 quarters of application (~2 years); three-year brief maps to fully observed 8Q window for 2020???22 cohorts',
  lowestAppsState: ranked[0].code,
  lowestAppsPerEmployer: ranked[0].appsPerEmployer,
  highestAppsState: ranked[ranked.length-1].code,
  highestAppsPerEmployer: ranked[ranked.length-1].appsPerEmployer,
  medianAppsPerEmployer: +[...states].sort((a,b)=>a.appsPerEmployer-b.appsPerEmployer)[Math.floor(states.length/2)].appsPerEmployer.toFixed(2),
  statesAbove4: states.filter(s=>s.appsPerEmployer>=4).length,
  statesBelow3: states.filter(s=>s.appsPerEmployer<3).length,
  usHbaCohort: Math.round(natCohort.hba.s),
  usBf8qCohort: Math.round(natCohort.bf.s),
  usBaCohort: Math.round(natCohort.ba.s),
  hbaShareCohortPct: +(100*natCohort.hba.s/natCohort.ba.s).toFixed(1),
};
const regionAgg={};
for(const s of states){
  if(!regionAgg[s.region]) regionAgg[s.region]={hba:0,bf:0};
  regionAgg[s.region].hba+=s.hba2020_22; regionAgg[s.region].bf+=s.bf8q2020_22;
}
const regionsOut=Object.entries(regionAgg).map(([region,v])=>({region, hba:v.hba, bf8q:v.bf, appsPerEmployer:+(v.hba/v.bf).toFixed(2), conversionPct:+(100*v.bf/v.hba).toFixed(1)}));
fs.writeFileSync('tmp/bfs/agg.json', JSON.stringify({headline, states, annual, monthly: monthly.filter((_,i)=>i%1===0), regions:regionsOut}, null, 2));
console.log(JSON.stringify(headline,null,2));
console.log('states', states.length, 'top', states.slice(0,5).map(s=>s.code+':'+s.appsPerEmployer));
console.log('bottom', ranked.slice(0,5).map(s=>s.code+':'+s.appsPerEmployer));
"
