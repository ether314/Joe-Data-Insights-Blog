# Retry with throttle - batch of states
$states = @('AL','AK','AZ','AR','CA','CO','CT','DE','DC','FL','GA','HI','ID','IL','IN','IA','KS','KY','LA','ME','MD','MA','MI','MN','MS','MO','MT','NE','NV','NH','NJ','NM','NY','NC','ND','OH','OK','OR','PA','RI','SC','SD','TN','TX','UT','VT','VA','WA','WV','WI','WY')
$ok=0; $fail=@()
foreach ($st in $states) {
  foreach ($pair in @(@('hba',"BAHBATOTALSA$st"), @('bf8q',"BFSBF8QTOTALNSA$st"))) {
    $kind=$pair[0]; $id=$pair[1]
    $out = "tmp\bfs\states\${st}_${kind}.csv"
    if ((Test-Path $out) -and (Get-Item $out).Length -gt 100) {
      $first = Get-Content $out -TotalCount 1
      if ($first -match 'observation_date') { $ok++; continue }
    }
    curl.exe -sL --max-time 45 -o $out "https://fred.stlouisfed.org/graph/fredgraph.csv?id=$id"
    Start-Sleep -Milliseconds 350
    if ((Test-Path $out) -and (Get-Item $out).Length -gt 100 -and ((Get-Content $out -TotalCount 1) -match 'observation_date')) { $ok++ } else { $fail += $id; Write-Output "FAIL $id size=$((Get-Item $out -EA SilentlyContinue).Length)" }
  }
}
Write-Output "ok=$ok failCount=$($fail.Count)"
Write-Output ($fail -join ',')
(Get-ChildItem tmp\bfs\states | Measure-Object).Count
